<layout>
    <!-- date et heure -->
    <component type="datetime" format="%d/%m/%Y %H:%M:%S" cache="false" size="85" x="27" y="27" name="datetime_1"/>

    <!-- vitesse sol en km/h -->
    <composite x="4630" y="2374" name="speed">
       <component type="msi" metric="speed" textsize="37" needle="1" units="kph" size="427" end="80" yellow="80" green="80" name="msi_speed_1"/>
       <component type="metric" metric="speed" units="kph" dp="0" size="96" x="213"  y="320" align="centre" name="metric_speed_1"/>
       <component type="metric_unit" metric="speed" units="kph" size="48"  x="213"  y="427" align="centre" name="metric_unit_speed_1">{:~P}</component>
    </composite>

    <!-- bpm -->
    <composite x="5070" y="27" name="bpm">
        <component type="metric_unit" metric="hr" x="-187" y="0" size="43" align="right" name="metric_unit_hr_1">{:~P}</component>
        <component type="icon" x="-171" y="0" file="heartbeat.png" size="107" name="icon_heartbeat_1"/>
        <component type="metric" x="-187" y="48" metric="hr" dp="0" size="85" align="right" name="metric_hr_1"/>
       <composite x="-267" y="133" name="composite_1">
          <composite x="-27" name="bpm_min">
             <component type="text" size="32" align="right" name="text_min_1">min</component>
             <component type="custom_calc" y="27" size="48" dp="0"  expression="precalc.get('min_hr', 0)" align="right" name="custom_calc_1"/>
          </composite>
          <composite x="67" name="bpm_max">
             <component type="text" size="32" align="right" name="text_max_1">max</component>
             <component type="custom_calc" y="27" size="48" dp="0"  expression="precalc.get('max_hr', 0)" align="right" name="custom_calc_2"/>
          </composite>
       </composite>
    </composite>

    <!-- altitude -->
    <composite x="5070" y="293" name="alt">
       <component type="metric_unit" metric="alt" x="-187" y="0" size="43" align="right" name="metric_unit_alt_1">{:~P}</component>
       <component type="icon" x="-171" y="0" file="mountain.png" size="107" name="icon_mountain_1"/>
       <component type="metric" metric="alt" x="-187" y="48" dp="0" size="85" align="right"  name="metric_alt_1"/>
       <composite x="-293" y="133" name="composite_2">
          <composite x="0" name="alt-min">
             <component type="text" size="32" align="right" name="text_min_2">min</component>
             <component type="custom_calc" y="27" size="48" dp="0" expression="precalc.get('min_alt', 0)" align="right" name="custom_calc_3"/>
          </composite>
          <composite x="107" name="alt_max">
             <component type="text" size="32" align="right" name="text_max_2">max</component>
             <component type="custom_calc" y="27" size="48" dp="0" expression="precalc.get('max_alt', 0)" align="right" name="custom_calc_4"/>
          </composite>
       </composite>
    </composite>

    <!-- dénivelé -->
    <composite x="5070" y="560" name="deniv">
       <component type="text" x="-187" size="43" align="right" name="text_m_1">m</component>
       <component type="icon" x="-171" y="0" file="slope.png" size="107"  name="icon_slope_1"/>
       <component type="custom-calc" x="-187" y="48" expression="precalc.get('total_gain', 0)" label="D+" dp="0" size="85" align="right"  name="custom_calc_d_1"/>
       <component type="custom-calc" x="-187" y="133" expression="precalc.get('total_loss', 0)" label="D-" dp="0" size="85" align="right"  name="custom_calc_d_2"/>
    </composite>

    <composite x="5070" y="827" name="vario">
       <component type="text" x="-187" size="43" align="right" name="text_m_s_1">m/s</component>
       <component type="icon" x="-171" y="0" file="slope-triangle.png" size="107"  name="icon_slope_triangle_1"/>
       <component type="custom-calc" x="-187" y="48" dp="2" size="85" align="right" expression="vspeed" name="custom_calc_5"/>
    </composite>

    <!-- carte -->
    <translate x="27" y="2267" name="translate_1">
       <frame  width="587" height="587" cr="53" name="frame_1">
          <component type="journey_map" size="587" opacity="0.7"   name="journey_map_1"/>
       </frame>
       <!-- distance -->
       <component type="metric_unit" metric="odo" x="320" y="480" size="43" align="right" name="metric_unit_odo_1">{:~P}</component>
       <component type="metric" metric="odo"  align="right" x="320" y="533" size="53" name="metric_odo_1"/>
    </translate>

    <composite x="640" y="2267" name="deco/attero">
       <component type="text" size="43" name="text_deco_m_1">Deco (m)</component>
       <component type="custom-calc" y="40" expression="state.setdefault('alt_start', alt)" dp="0" size="85"  name="custom_calc_6"/>

       <component type="text" y="160" size="43" name="text_attero_m_1">Attero (m)</component>
        <component type="custom-calc" y="213" expression="precalc.get('min_alt', 0)" dp="0" size="85"   name="custom_calc_7"/>
    </composite>
</layout>
