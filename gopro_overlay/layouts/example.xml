<layout>
    <!--    Some bundled components-->
    <component type="chart" x="400" y="980" name="chart_1"/>

    <composite x="260" y="30" name="date_and_time">
        <component type="datetime" x="0" y="0" format="%Y/%m/%d" size="16" align="right" name="datetime_1"/>
        <component type="datetime" x="0" y="24" format="%H:%M:%S.%f" truncate="5" size="32" align="right" name="datetime_2"/>
    </composite>

    <composite x="1644" y="36" name="gps_info">
        <component type="text" x="256" y="0" size="16" align="right" name="text_gps_info_1">GPS INFO</component>
        <component type="text" x="0" y="24" size="16" align="left" name="text_lat_1">Lat: </component>
        <component type="text" x="128" y="24" size="16" align="left" name="text_lon_1">Lon: </component>
        <component type="metric" x="118" y="24" metric="lat" dp="6" size="16" align="right" cache="False" name="metric_lat_1"/>
        <component type="metric" x="256"    y="24" metric="lon" dp="6" size="16" align="right" cache="False" name="metric_lon_1"/>
    </composite>

    <composite x="16" y="800" name="big_mph">
        <component type="metric_unit" metric="speed" units="speed" size="16" name="metric_unit_speed_1">{:~c}</component>
        <component type="metric" x="0" y="0" metric="speed" units="mph" dp="0" size="160"  name="metric_speed_1"/>
    </composite>

    <!-- components with metric and icon -->
    <composite x="220" y="980" name="gradient">
        <component type="text" x="70" y="0" size="16" name="text_slope_1">SLOPE(%)</component>
        <component type="icon" x="0" y="0" file="slope-triangle.png" size="64" name="icon_slope_triangle_1"/>
        <component type="metric" x="70" y="18" metric="gradient" dp="1" size="32"  name="metric_gradient_1"/>
    </composite>

    <composite x="1900" y="820" name="temperature">
        <component type="metric_unit" x="-70" y="0" size="16" align="right" metric="temp" units="temp" name="metric_unit_temp_1">TEMP({:~C})</component>
        <component type="icon" x="-64" y="0" file="thermometer.png" size="64" name="icon_thermometer_1"/>
        <component type="metric" x="-70" y="18" dp="0" size="32" align="right" metric="temp" units="temp" name="metric_temp_1"/>
    </composite>

    <composite x="1900" y="900" name="cadence">
        <component type="text" x="-70" y="0" size="16" align="right" name="text_rpm_1">RPM</component>
        <component type="icon" x="-64" y="0" file="gauge.png" size="64" name="icon_gauge_1"/>
        <component type="metric" x="-70" y="18" metric="cadence" dp="0" size="32" align="right" name="metric_cadence_1"/>
    </composite>

    <composite x="1900" y="980" name="heartbeat">
        <component type="text" x="-70" y="0" size="16" align="right" name="text_bpm_1">BPM</component>
        <component type="icon" x="-64" y="0" file="heartbeat.png" size="64" name="icon_heartbeat_1"/>
        <component type="metric" x="-70" y="18" metric="hr" dp="0" size="32" align="right" name="metric_hr_1"/>
    </composite>
    <!-- see default-1920x1080.xml for these -->

    <!--    Basic Components-->

    <!-- Maps size=square size of map, zoom=open street map zoom level-->
    <component type="moving_map" x="1644" y="100" size="256" zoom="16" name="moving_map_1"/>
    <component type="moving_map" x="1644" y="700" size="256" zoom="16" corner_radius="35" opacity="0.5" name="moving_map_2"/>
    <component type="journey_map" x="1644" y="376" size="256" name="journey_map_1"/>
    <component type="journey_map" x="1344" y="700" size="256" corner_radius="128" opacity="0.5" name="journey_map_2"/>

    <!--    Static Text-->
    <component type="text" x="800" y="480" size="32" rgb="255,255,0" name="text_c_some_copyright_messag_1">(C) Some Copyright Message</component>
    <component type="text" x="800" y="480" size="48" align="right" name="text_c_some_copyright_messag_2">(C) Some Copyright Message</component>

    <component type="text" x="1400" y="150" size="32" align="lt" direction="ttb" rgb="0,255,255" name="text_vertical_message_1">Vertical Message</component>

    <!--  Some metric from the gopro data or calculated from it -->
    <!-- supported metrics: 'hr', 'speed', 'temp', 'gradient', 'alt', 'lat', 'lon', 'odo', "dist", "azi" -->
    <!-- odo = odometer - total distance travelled, dist = dist from last point, azi = azimuth/heading -->
    <!-- supported units: mph, kph, mps, knots, miles, nautical_miles, degreeF, degreeC -->
    <!-- use 'format' for python format string, or 'dp' to give # of decimal places -->
    <!-- consider use 'cache' False for values that change a lot, and don't have a fixed set of values, e.g. lat/lon -->
    <component type="metric" x="800" y="600" metric="speed" format=".1f" size="32" name="metric_speed_2"/>
    <component type="metric" x="900" y="600" metric="speed" units="mph" format=".1f" size="32" name="metric_speed_3"/>
    <component type="metric" x="1000" y="600" metric="speed" units="kph" format=".1f" size="32" name="metric_speed_4"/>
    <component type="metric" x="1100" y="600" metric="speed" units="mps" format=".1f" size="32" name="metric_speed_5"/>
    <component type="metric" x="1200" y="600" metric="speed" units="knots" format=".1f" size="32" name="metric_speed_6"/>

    <component type="metric" x="800" y="650" metric="hr" format=".4f" size="32" align="right" name="metric_hr_2"/>
    <component type="metric" x="850" y="700" metric="hr" dp="5" size="32" name="metric_hr_3"/>

    <component type="metric" x="850" y="750" metric="odo" units="miles" dp="2" size="32" rgb="255,255,0" name="metric_odo_1"/>
    <component type="metric" x="950" y="750" metric="odo" units="km" dp="2" size="32" rgb="255,255,0" name="metric_odo_2"/>

    <component type="metric" x="1050" y="750" metric="power" units="W" dp="2" size="32" rgb="255,255,0" name="metric_power_1"/>
    <component type="metric" x="1050" y="800" metric="power" units="kW" dp="2" size="32" rgb="255,255,0" name="metric_power_2"/>

    <composite name="metrics" x="250" y="300">
        <component type="metric" x="0" y="0" metric="alt" dp="1" size="32" name="metric_alt_1"/>
        <component type="metric" x="0" y="50" metric="alt" units="feet" dp="1" size="32" name="metric_alt_2"/>
        <component type="metric" x="0" y="100" metric="alt" units="miles" dp="1" size="32" name="metric_alt_3"/>
        <component type="metric" x="0" y="150" metric="alt" units="nautical_miles" dp="1" size="32" name="metric_alt_4"/>
    </composite>

    <component type="metric" x="250" y="700" metric="lat" dp="5" size="32" cache="False" name="metric_lat_2"/>
    <component type="metric" x="250" y="750" metric="lon" dp="5" size="32" cache="False" name="metric_lon_2"/>

    <component type="metric" x="950" y="50" metric="accl.x" units="gravity" dp="2" size="32" rgb="255,0,255" name="metric_accl_x_1"/>
    <component type="metric" x="1000" y="50" metric="accl.y" units="G" dp="2" size="32" rgb="255,0,255" name="metric_accl_y_1"/>
    <component type="metric" x="1050" y="50" metric="accl.z" units="G" dp="2" size="32" rgb="255,0,255" name="metric_accl_z_1"/>

    <component type="metric" x="950" y="150" metric="grav.x" dp="2" size="32" rgb="255,255,0" name="metric_grav_x_1"/>
    <component type="metric" x="1000" y="150" metric="grav.y" dp="2" size="32" rgb="255,255,0" name="metric_grav_y_1"/>
    <component type="metric" x="1050" y="150" metric="grav.z" dp="2" size="32" rgb="255,255,0" name="metric_grav_z_1"/>

    <!-- Bar / Acceleration -->
    <translate x="50" y="550" name="translate_1">
        <component type="bar" width="400" height="50" metric="accl.x" outline="0,0,0,0" fill="255,0,255" name="bar_accl_x_1"/>
    </translate>

    <translate x="50" y="600" name="translate_2">
        <component type="bar" width="400" height="50" metric="accl.y" units="G" name="bar_accl_y_1"/>
    </translate>

    <!--    Date and time-->
    <component type="datetime" x="1000" y="250" format="%Y/%m/%d" size="32"  name="datetime_3"/>
    <component type="datetime" x="1000" y="300" format="%H:%M:%S.%f" size="32" cache="False" name="datetime_4"/>
    <component type="datetime" x="1000" y="350" format="%H:%M:%S.%f" size="32" truncate="4" name="datetime_5"/>

    <!--  icon  (bundled icons are actually black, so need invert to be white )-->
    <composite name="icons" x="64" y="100">
        <component type="icon" x="0" y="0" file="mountain.png" size="128" name="icon_mountain_1"/>
        <component type="icon" x="192" y="0" file="mountain.png" size="128" invert="False" name="icon_mountain_2"/>
    </composite>
    <!-- icon somewhere on filesystem -->
    <!--    <component type="icon" x="64" y="100" file="/home/bob/blah.png" size="128"/>-->

    <translate x="150" y="150" name="translate_3">
        <frame width="150" height="150" outline="255,255,0" opacity="0.6" name="frame_1">
            <component type="moving_map" x="0" y="0" size="256" zoom="16" name="moving_map_3"/>
        </frame>
    </translate>

    <translate x="250" y="250" name="translate_4">
        <component type="cairo_circuit_map" size="512" name="cairo_circuit_map_1"/>
    </translate>

    <composite name="compass" x="500" y="100">
        <component type="compass" size="300" bg="0,0,0,128" fg="255,255,255" text="0,255,255" textsize="16" name="compass_1"/>

        <translate x="180" name="translate_5">
            <component type="compass" size="300" fg="255,255,255" text="0,255,255" textsize="32" name="compass_2"/>
        </translate>

        <translate x="350" name="translate_6">
            <component type="compass-arrow" size="200" bg="0,0,0,0" arrow="255,0,255" text="0,0,0" textsize="32" name="compass_arrow_1"/>
        </translate>
    </composite>

    <translate x="700" y="800" name="translate_7">
        <component type="asi" vs0="10" name="asi_1"/>
        <translate x="256" name="translate_8">
            <component type="asi" vs0="10" rotate="180" name="asi_2"/>
        </translate>
    </translate>
</layout>
