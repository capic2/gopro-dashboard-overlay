<layout>
	<translate x="32" name="translate_1">
		<composite name="metrics" x="0">
			<component type="datetime" y="32" format="%d.%m.%Y" size="48" outline_width="4" align="left" name="datetime_1"/>
			<component type="datetime" y="90" format="%H:%M:%S" size="64" outline_width="4" align="left" name="datetime_2"/>
			<translate y="180" name="translate_2">
				<component type="icon" x="0"  file="mountain.png" size="96" name="icon_mountain_1"/>
				<component type="text" outline_width="4" x="130"  size="32" name="text_alt_m_1">ALT (m)</component>
				<component type="metric" outline_width="4" x="110" y="40" align="left"  metric="alt" dp="1" size="52"  name="metric_alt_1"/>
			</translate>
			<translate y="300" name="translate_3">
				<component type="icon" x="0"  file="slope-triangle.png" size="96" name="icon_slope_triangle_1"/>
				<component type="text" outline_width="4" x="130"  size="32" name="text_slp_1">SLP (%)</component>
				<component type="metric" outline_width="4" x="140" y="40" align="left" metric="gradient" dp="1" size="52"  name="metric_gradient_1"/>
			</translate>	
		</composite>
				
		<translate x="0" y="1380" name="translate_4">
			<component type="msi" metric="speed" outline="4" size="512" textsize="32" needle="1" units="kph"  name="msi_speed_1"/>
			<translate x="256"  y="420" name="translate_5">
					<component type="metric" metric="speed" units="kph" dp="0" size="72" outline_width="4" align="centre" name="metric_speed_1"/>
			</translate>	
			<translate x="256"  y="320" name="translate_6">
					<component type="text" size="36" outline_width="4" align="centre" name="text_km_h_1">km/h</component>
			</translate>	
			
			<translate x="0" y="520"  name="translate_7">
				<component type="bar" width="256" min="-3" max="0" height="80" metric="accel" outline-width="4" bar="255,157,157" h-neg="255,157,157" h-pos="255,157,157" zero="0,0,0,0" name="bar_accel_1"/>
				<component x="126" y="22" type="text" outline_width="4" size="32" align="centre" name="text_brake_1">BRAKE</component>
				<translate x="254"  name="translate_8">
					<component type="bar" width="256" min="0" max="3" height="80" metric="accel" outline-width="4" bar="157,157,255" h-neg="157,157,255" h-pos="157,157,255"  zero="0,0,0,0" name="bar_accel_2"/>
					<component x="126" y="22" type="text" outline_width="4" size="32" align="centre" name="text_throttle_1">THROTTLE</component>
				</translate>
			</translate>			
		</translate>
		
		<translate x="3264" y="32" name="translate_9">
			<frame width="512" opacity="0.6" height="512" cr="40" fo="40" name="frame_1">
				<component type="moving_map"  name="moving_map" size="512" zoom="15"/>
			</frame>
			<frame y="512" width="512" opacity="0.6" height="512" cr="40" fo="40" name="frame_2">
					<component type="moving_journey_map" size="512" zoom="14"  name="moving_journey_map_1"/>
			</frame>
		</translate>
			
	</translate>
	
	<component x="14" y="2020" height="128" samples="512" type="chart" name="chart" metric="speed" units="kph" fill="0,191,255,128" bg="0,0,0,128" values="false"/>
</layout>
