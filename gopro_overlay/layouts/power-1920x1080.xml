<layout>
    <composite x="260" y="30" name="date_and_time">
        <component type="datetime" x="0" y="0" format="%Y/%m/%d" size="16" align="right" name="datetime_1"/>
        <component type="datetime" x="0" y="24" format="%H:%M:%S.%f" truncate="5" size="32" align="right" name="datetime_2"/>
    </composite>

    <composite x="1644" y="0" name="gps_info">
        <frame name="gps-lock" x="226" y="24" width="32" height="32" bg="0,0,0,128" cr="5" opacity="0.4">
            <component type="gps-lock-icon" size="32" name="gps_lock_icon_1"/>
         </frame>

        <composite y="36" name="composite_1">
            <component type="text" x="0" y="0" size="16" align="left" name="text_gps_info_1">GPS INFO</component>
            <component type="text" x="0" y="24" size="16" align="left" name="text_lat_1">Lat: </component>
            <component type="text" x="128" y="24" size="16" align="left" name="text_lon_1">Lon: </component>
            <component type="metric" x="118" y="24" metric="lat" dp="6" size="16" align="right" cache="False" name="metric_lat_1"/>
            <component type="metric" x="256"    y="24" metric="lon" dp="6" size="16" align="right" cache="False" name="metric_lon_1"/>
        </composite>
    </composite>

    <composite x="16" y="800" name="big_kph">
        <component type="metric_unit" metric="speed" units="speed" size="16" name="metric_unit_speed_1">{:~c}</component>
        <component type="metric" x="0" y="0" metric="speed" units="speed" dp="0" size="160"  name="metric_speed_1"/>
    </composite>

    <component type="chart" name="gradient_chart" x="400" y="980"  units="alt"/>

    <composite x="220" y="980" name="gradient">
        <component type="text" x="70" y="0" size="16" name="text_slope_1">SLOPE(%)</component>
        <component type="icon" x="0" y="0" file="slope-triangle.png" size="64" name="icon_slope_triangle_1"/>
        <component type="metric" x="70" y="18" metric="gradient" dp="1" size="32"  name="metric_gradient_1"/>
    </composite>

    <composite x="16" y="980" name="altitude">
        <component type="metric_unit" x="70" y="0" metric="alt" units="alt" size="16" name="metric_unit_alt_1">ALT({:~C})</component>
        <component type="icon" x="0" y="0" file="mountain.png" size="64" name="icon_mountain_1"/>
        <component type="metric" x="70" y="18" metric="alt" units="alt" dp="1" size="32"  name="metric_alt_1"/>
    </composite>

    <composite x="1900" y="820" name="cadence">
        <component type="text" x="-70" y="0" size="16" align="right" name="text_rpm_1">RPM</component>
        <component type="icon" x="-64" y="0" file="gauge.png" size="64" name="icon_gauge_1"/>
        <component type="metric" x="-70" y="18" metric="cadence" dp="0" size="32" align="right" name="metric_cadence_1"/>
    </composite>

    <composite x="1900" y="900" name="heartbeat">
        <component type="text" x="-70" y="0" size="16" align="right" name="text_bpm_1">BPM</component>
        <component type="icon" x="-64" y="0" file="heartbeat.png" size="64" name="icon_heartbeat_1"/>
        <component type="metric" x="-70" y="18" metric="hr" dp="0" size="32" align="right" name="metric_hr_1"/>
        <translate x="-930" name="heartbeat-zone">
            <component type="zone-bar" width="800" height="75" metric="hr" max="200" z1="130" z2="163" z3="183" z0-rgb="52, 122, 235,200" z1-rgb="67,235,52,200" z2-rgb="240,232,19,200" z3-rgb="207,19,2,200" name="zone_bar_hr_1"/>
        </translate>
    </composite>

    <composite x="1900" y="980" name="power">
        <component type="text" x="-70" y="0" size="16" align="right" name="text_watt_1">Watt</component>
        <component type="icon" x="-64" y="0" file="power.png" size="64" name="icon_power_1"/>
        <component type="metric" x="-70" y="18" metric="power" dp="0" size="32" align="right" name="metric_power_1"/>
        <translate x="-930" name="power-zone">
            <component type="zone-bar"  width="800" height="75" metric="power" max="600" z1="130" z2="160" z3="200" z0-rgb="67, 235, 52,200" z1-rgb="67,235,52,200" z2-rgb="240,232,19,200" z3-rgb="207,19,2,200"  name="zone_bar_power_1"/>
        </translate>
    </composite>


    <component type="moving_map" name="moving_map" x="1644" y="100" size="256" zoom="16" corner_radius="35"/>
    <component type="journey_map" name="journey_map" x="1644" y="376" size="256" corner_radius="35"/>
</layout>
