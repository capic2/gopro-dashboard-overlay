            <component size="256" type="cairo-gauge-marker" metric="gear.front" max="2" start="90" background-rgb="0,0,0,64" gauge-rgb="255,0,0,64" dot-inner-rgb="255,0,0,128" name="cairo_gauge_marker_gear_front_1"/>
