<layout>
    <translate x="16" name="translate_1">
        <translate y="100" name="translate_2">
            <frame width="170" height="64" cr="30" opacity="0.6" name="frame_1">
                <translate x="15" name="translate_3">
                    <component type="icon" file="gauge.png" invert="true" name="icon_gauge_1"/>
                    <translate x="80" y="4" name="translate_4">
                        <component type="metric" metric="speed" units="kph" dp="0" size="48" rgb="255,0,0" outline="255,255,255" outline_width="5" name="metric_speed_1"/>
                    </translate>
                </translate>
            </frame>
        </translate>

        <translate y="200" name="translate_5">
            <component type="text" size="16" name="text_kph_1">kph</component>
            <component type="metric" metric="speed" units="kph" dp="0" size="200" name="metric_speed_2"/>
        </translate>

        <translate y="800" name="translate_6">
            <component type="text" size="16" name="text_mph_1">mph</component>
            <component type="metric" metric="speed" units="mph" dp="0" size="200" name="metric_speed_3"/>
        </translate>

        <translate y="450" name="translate_7">
            <component type="chart" name="chart" metric="speed" units="mph" fill="177,26,22" values="false"/>
            <translate x="230" y="40" name="translate_8">
                <component type="metric" metric="speed" units="mph" dp="1" name="metric_speed_4"/>
            </translate>
        </translate>

        <translate y="550" name="translate_9">
            <component type="asi" metric="speed" units="mph" vs0="0" vs="0" vfe="0" vno="40" vne="50" rotate="180" name="asi_speed_1"/>
            <translate x="100" y="210" name="translate_10">
                <component type="text" size="32" name="text_mph_2">MPH</component>
            </translate>
        </translate>
    </translate>
</layout>
